# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# build artifacts
*.tar.gz
*.zip
*.7z

.vercel

# UI 验证截图产物 (scripts/verify-ui.js)
verify-*.png
verify-*.jpg

# AI 抠图大文件（模型/WASM 二进制，可从 hf-mirror + npm 重新下载，见 docs/ai-background-removal-plan.md）
public/models/*.onnx
public/ort/*.wasm

# 百度推送 token（敏感，勿提交）
.baidu-token
